type sysfs_doze, sysfs_type, fs_type;

allow system_app hal_motor_hwservice_xiaomi:hwservice_manager find;

binder_call(system_app, hal_motor)

allow system_app sysfs_doze:file rw_file_perms;

allow system_app { motor_device vendor_sysfs_graphics sysfs_leds }:dir search;
allow system_app { cgroup vendor_sysfs_graphics }:file rw_file_perms;
allow system_app { motor_device vendor_sysfs_graphics hall_device }:chr_file rw_file_perms;

# Haptic strength / FPS info (XiaomiParts)
allow system_app sysfs_vibrator:dir search;
allow system_app sysfs_vibrator:file rw_file_perms;
allow system_app vendor_sysfs_graphics:file { getattr open read };

# XiaomiParts - TouchFeature HIDL service
allow system_app hal_touchfeature_xiaomi_hwservice:hwservice_manager find;

allow system_app sysfs_vibrator:file rw_file_perms;
allow system_app sysfs_vibrator:dir search;

allow system_app vendor_sysfs_graphics:file { getattr open read };
allow system_app sysfs_touchpanel:file rw_file_perms;
allow system_app sysfs_touchpanel:dir search;

allow system_app sysfs_thermal:file { read open getattr };
allow system_app sysfs_thermal:dir { read open search };
allow system_app sysfs_devices_system_cpu:dir { read open search };
allow system_app sysfs_devices_system_cpu:file { read open getattr write };
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;
allow system_app vendor_sysfs_battery_supply:dir search;

allow system_app sysfs_leds:dir search;
allow system_app vendor_sysfs_graphics:dir search;

allow system_app proc_stat:file { read open getattr };

# Core Control
allow system_app sysfs_devices_system_cpu:file rw_file_perms;

# Overlay permission
allow system_app appops_service:service_manager find;
allow system_app system_app_data_file:file { read write getattr open };


