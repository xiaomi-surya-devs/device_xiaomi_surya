dontaudit init bt_firmware_file:filesystem getattr;
dontaudit init firmware_file:filesystem getattr;

allow init firmware_file:file mounton;

# XiaomiParts perf profile / haptic / HBM / CABC
allow init vendor_sysfs_graphics:dir search;
allow init vendor_sysfs_graphics:file rw_file_perms;
allow init vendor_sysfs_cpu_boost:{ file lnk_file } rw_file_perms;
allow init vendor_sysfs_devfreq:dir search;
allow init vendor_sysfs_devfreq:{ file lnk_file } rw_file_perms;
allow init vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;
allow init vendor_sysfs_msm_power:dir search;
allow init vendor_sysfs_msm_power:{ file lnk_file } rw_file_perms;
allow init sysfs_vibrator:dir search;
allow init sysfs_vibrator:file rw_file_perms;
allow init sysfs_hbm:file rw_file_perms;

# Battery / KCAL ownership setup
allow init vendor_sysfs_battery_supply:dir search;
allow init vendor_sysfs_battery_supply:file { getattr setattr };
allow init kcal_dev:dir search;
allow init kcal_dev:file { getattr setattr };
